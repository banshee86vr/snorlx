# Rendered by the nginx image entrypoint: ${BACKEND_UPSTREAM} and ${BASE_PATH} are substituted from the environment.
# The frontend serves the SPA and proxies /api and /ws to the backend so the browser only ever
# talks to one origin: cookies stay first-party, CSP connect-src stays 'self', and the backend
# CSRF/WebSocket origin checks compare against the public URL.

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # Drop the base path (empty at the host root) before the locations below are matched
    rewrite ^${BASE_PATH}(/.*)$ $1;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_vary on;

    include /etc/nginx/snippets/security-headers.conf;

    # REST API: forwarded to the backend with the real client address
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 70s;
        proxy_send_timeout 70s;
        client_max_body_size 11m;
    }

    # WebSocket: forwarded with the upgrade headers and the browser Origin
    location = /ws {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Hashed static assets: cache for a year
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA routing: serve index.html for all routes, with the base path set in its <base> tag
    location / {
        try_files $uri $uri/ /index.html;
        sub_filter '<base href="/" />' '<base href="${BASE_PATH}/" />';
        sub_filter_once on;
    }

    # Health check for container and Kubernetes probes
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy";
    }
}
